{
  "name": "image-processor",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/handler.ts --bundle --platform=node --target=node24 --format=cjs --external:sharp --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "rm -rf dist/lambda dist/function.zip && mkdir dist/lambda && cp dist/index.js dist/lambda/ && npm install --prefix dist/lambda --no-save --no-package-lock --os=linux --cpu=arm64 --libc=glibc sharp@$(node -p \"require('sharp/package.json').version\") && cd dist/lambda && zip -qr ../function.zip index.js node_modules",
    "local": "esbuild src/runLocal.ts --bundle --platform=node --target=node24 --format=cjs --external:sharp --outfile=dist/local.js --log-level=warning && node dist/local.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-ssm": "^3.1161.0",
    "heic-decode": "^2.1.0",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  }
}
