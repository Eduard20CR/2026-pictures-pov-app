# Copy this file to .env and fill in the values: cp .env.example .env
# Values for dev: terraform output in infra/environments/dev/app, or the repo variables DEV_COGNITO_*.
VITE_COGNITO_AUTHORITY=https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
VITE_COGNITO_CLIENT_ID=<app-client-id>
VITE_COGNITO_DOMAIN=https://<domain-prefix>.auth.<region>.amazoncognito.com
